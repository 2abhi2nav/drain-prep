# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
build/
dist/

# Data (raw IMD binaries are large; interim/processed are regenerable)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Committed on purpose: the deployed API loads the fitted model and the daily
# rainfall series at import time. Everything else under data/ stays regenerable.
!data/processed/model.json
!data/interim/chennai_daily.csv
outputs/**/*
!outputs/**/.gitkeep

.streamlit/secrets.toml
.ipynb_checkpoints/

# Frontend packages (vanilla JS; pnpm artifacts from earlier setup)
**/node_modules/
web/dist/
